      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT License"
          }
        }
      }
    },
    "Mac 登录密码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac login password"
          }
        }
      }
    },
    "ipatool": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ipatool"
          }
        }
      }
    },
    "ipatool 第一次登录时会下载运行所需的组件，可能需要几分钟，请保持网络畅通。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time you sign in, ipatool downloads the components it needs. This can take a few minutes, so keep your network connected."
          }
        }
      }
    },
    "ipatool 许可（MIT）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ipatool License (MIT)"
          }
        }
      }
    },
    "“ipatool”想要使用钥匙串中的机密信息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“ipatool” wants to use confidential information stored in your keychain"
          }
        }
      }
    },
    "下载": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        }
      }
    },
    "下载位置": {
      "localizations": {
        "en": {
