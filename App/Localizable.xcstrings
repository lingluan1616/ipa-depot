      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ID"
          }
        }
      }
    },
    "IPA Depot": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IPA Depot"
          }
        }
      }
    },
